# Token này Node-RED dùng để ghi vào InfluxDB. Tự đặt một chuỗi ngẫu nhiên dài.
# Tạo nhanh trên Linux/macOS:  openssl rand -hex 32
# Trên Windows PowerShell:     -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
