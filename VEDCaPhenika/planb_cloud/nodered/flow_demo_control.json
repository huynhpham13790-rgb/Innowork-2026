  {
    "id": "data_store",
    "type": "function",
    "z": "1c36b21664cab788",
    "name": "nho so do moi nhat",
    "func": "// Giu lai ban tin data gan nhat de trang hien duoc so THAT.\n// Chi DOC topic data — khong dung vao, khong bien doi, khong gui di dau.\n// Hop dong du lieu (docs/DATA_CONTRACT.md) la thu khong duoc tu y sua.\nconst p = msg.payload || {};\nconst d = p.d || {};\nconst dev = Object.keys(d)[0];\nif (!dev) return null;\nconst v = d[dev];\n\nconst cells = [];\nfor (let i = 1; i <= 8; i++) {\n    const k = 'Cell' + String(i).padStart(2, '0') + '_Temp';\n    if (v[k] === undefined) break;\n    cells.push(v[k]);\n}\n\nconst prev = flow.get('live') || {};\nconst live = Object.assign({}, prev, { device: dev, ts: p.ts, seen: Date.now() });\nif (cells.length) live.cells = cells;\n\n// Cac truong AI chi di kem ban tin BAT THUONG (publishAnomaly), khong co trong\n// moi goi data. Nen chi ghi de khi that su co mat — neu khong, mot goi data\n// binh thuong se XOA MAT ket luan cua AI va trang se trong rong dung luc dang\n// bao dong.\nfor (const k of ['AI_Alarm','AI_WorstCell','AI_WorstScore',\n                 'AI_Pattern','AI_Dev','AI_DtDiff','AI_Shock',\n                 'Alarm_Level','Alarm_Muted','Alarm_Quiet','Alarm_Events',\n                 'Heater_On','Heater_State','Heater_Delta',\n                 'Sensor_Healthy','Sensor_Found']) {\n    if (v[k] !== undefined) live[k] = v[k];\n}\nflow.set('live', live);\nreturn null;\n",
    "outputs": 0,
    "x": 400,
    "y": 420,
    "wires": []
  }
