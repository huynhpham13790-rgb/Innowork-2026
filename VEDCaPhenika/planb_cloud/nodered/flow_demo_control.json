    {
        "id": "app_tmpl",
        "type": "template",
        "z": "1c36b21664cab788",
        "name": "app BLE cho dien thoai",
        "field": "payload",
        "fieldType": "msg",
        "format": "html",
        "syntax": "plain",
        "template": "<!doctype html>\n<html lang=\"vi\">\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#0f1115\">\n<title>Hủ Tiếu — Pack pin</title>\n<!--\n  App xem pack pin qua BLE, chạy thẳng trong Chrome trên Android.\n\n  VÌ SAO LÀ TRANG WEB CHỨ KHÔNG PHẢI APP THẬT\n  Web Bluetooth cho trang web nối BLE trực tiếp. Không cần cài đặt, không cần\n  Play Store, không cần ký số, và sửa gì thì tải lại là xong. Đổi lại:\n\n    - CHỈ CHẠY TRÊN ANDROID (Chrome/Edge). iOS Safari KHÔNG có Web Bluetooth,\n      và đó là giới hạn của iOS chứ không phải của trang này.\n    - Cần \"ngữ cảnh an toàn\": HTTPS, hoặc localhost, hoặc origin được khai báo\n      tin cậy trong chrome://flags. Mở bằng file:// sẽ KHÔNG chạy.\n\n  DỮ LIỆU KHÔNG QUA MẠNG. Trang tải về một lần rồi nói chuyện thẳng với ESP32\n  bằng sóng BLE. Không router, không cloud. Tắt Wi-Fi và 4G vẫn chạy.\n-->\n<style>\n:root{\n  --bg:#0f1115; --card:#171a21; --tx:#e8eaed; --dim:#9aa3af; --line:#262b34;\n  --ok:#35c17b; --watch:#e0a417; --alarm:#ff5f57; --crit:#ff2d43; --accent:#589bff;\n}\n@media (prefers-color-scheme:light){\n  :root{--bg:#f4f5f7;--card:#fff;--tx:#16181d;--dim:#6b7280;--line:#e3e6ea;\n        --ok:#12894f;--watch:#b8860b;--alarm:#d1342f;--crit:#8b0f1d;--accent:#1f6feb}\n}\n*{box-sizing:border-box}\nbody{margin:0 auto;max-width:560px;padding:14px;background:var(--bg);color:var(--tx);\n  font:16px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif;\n  -webkit-text-size-adjust:100%}\nh1{font-size:17px;margin:0 0 12px;display:flex;align-items:center;gap:8px}\nh1 small{font-weight:400;color:var(--dim);font-size:12px;margin-left:auto}\nh2{font-size:12px;text-transform:uppercase;letter-spacing:.6px;color:var(--dim);\n  margin:0 0 10px;font-weight:600}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;\n  padding:14px;margin-bottom:12px}\n#banner{border-radius:14px;padding:18px;margin-bottom:12px;color:#fff;background:#555}\n#banner .lvl{font-size:22px;font-weight:700}\n#banner .sub{opacity:.93;font-size:14px;margin-top:3px}\n.b-ok{background:var(--ok)!important} .b-watch{background:var(--watch)!important}\n.b-alarm{background:var(--alarm)!important} .b-crit{background:var(--crit)!important}\n.pulse{animation:p 1.1s infinite} @keyframes p{0%,100%{opacity:1}50%{opacity:.55}}\n.cells{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}\n.cell{border:1px solid var(--line);border-radius:10px;padding:9px 6px;text-align:center}\n.cell .n{font-size:11px;color:var(--dim)}\n.cell .t{font-size:19px;font-weight:600;font-variant-numeric:tabular-nums}\n.cell.hot{border-color:var(--alarm);background:rgba(255,95,87,.14)}\n.cell.hot .t{color:var(--alarm)}\n.diag{border-left:4px solid var(--alarm);padding-left:12px}\n.diag .what{font-weight:700;color:var(--alarm)}\n.diag .do{margin-top:6px;font-weight:600}\n.nums{margin-top:9px;font-size:13px;color:var(--dim);line-height:1.7;\n  font-variant-numeric:tabular-nums}\n.kv{display:flex;justify-content:space-between;gap:10px;padding:5px 0;\n  border-bottom:1px solid var(--line);font-size:14px}\n.kv:last-child{border-bottom:0}\n.kv b{font-variant-numeric:tabular-nums}\nbutton{font:inherit;font-weight:600;border-radius:10px;border:1px solid var(--line);\n  background:var(--card);color:var(--tx);padding:12px;width:100%;cursor:pointer}\nbutton:disabled{opacity:.45}\nbutton.on{background:var(--accent);border-color:var(--accent);color:#fff}\nbutton.big{background:var(--accent);border-color:var(--accent);color:#fff;font-size:17px;padding:16px}\n.row{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.warn{font-size:12px;color:var(--dim);margin-top:8px}\n#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:18px;z-index:9;\n  background:#000d;color:#fff;padding:10px 16px;border-radius:20px;font-size:14px;\n  opacity:0;transition:opacity .25s;pointer-events:none;max-width:90%}\n#gate{text-align:center;padding:30px 16px}\n#gate p{color:var(--dim);font-size:14px}\n.hide{display:none!important}\n</style>\n\n<h1>Pack pin 6 cell <small id=\"link\">chưa kết nối</small></h1>\n\n<div id=\"gate\" class=\"card\">\n  <p>Ứng dụng nối thẳng tới pack bằng <b>Bluetooth</b>.<br>\n     Không cần Wi-Fi, không cần 4G, không qua máy chủ nào.</p>\n  <button class=\"big\" id=\"btnConnect\">Kết nối tới pack</button>\n  <p class=\"warn\" id=\"gateWarn\">Đứng trong khoảng 10 m và bật Bluetooth.</p>\n</div>\n\n<div id=\"app\" class=\"hide\">\n  <div id=\"banner\"><div class=\"lvl\">Đang đọc…</div><div class=\"sub\" id=\"bsub\"></div></div>\n\n  <div class=\"card\"><h2>Nhiệt độ từng cell</h2><div class=\"cells\" id=\"cells\"></div></div>\n\n  <div class=\"card hide\" id=\"diagcard\"><h2>Chẩn đoán</h2>\n    <div class=\"diag\"><div class=\"what\" id=\"dwhat\"></div>\n      <div class=\"do\" id=\"ddo\"></div><div class=\"nums\" id=\"dnums\"></div></div>\n    <div class=\"warn\">Hệ phát hiện bất thường và phân loại <b>dạng</b>.\n      Nó không khẳng định nguyên nhân — hãy kiểm tra trực tiếp trước khi kết luận.</div>\n  </div>\n\n  <div class=\"card\"><h2>Pack</h2><div id=\"pack\"></div></div>\n\n  <div class=\"card hide\" id=\"l2card\"><h2>Sức khoẻ &amp; tuổi thọ pack</h2>\n    <div id=\"l2\"></div>\n    <div class=\"warn\" id=\"l2warn\"></div>\n  </div>\n\n  <div class=\"card\"><h2>Còi báo động</h2>\n    <div class=\"row\">\n      <button id=\"bmute\" onclick=\"cmd('mute')\">Tắt tiếng</button>\n      <button id=\"bquiet\" onclick=\"cmd('quiet')\">Bíp thưa</button>\n    </div>\n    <div class=\"warn\">Lần đầu bấm, điện thoại sẽ hỏi <b>mã ghép đôi</b>.\n      Ở mức <b>báo động</b>, tắt tiếng là <b>tắt hẳn</b> tới khi bật lại — nhưng màn hình vẫn báo bất thường chưa xử lý. Ở mức <b>nguy kịch</b>, còi <b>tự kêu lại sau 2 phút</b> để nhắc (QĐ-047).</div>\n  </div>\n\n  <div class=\"card\">\n    <button id=\"btnOff\" onclick=\"location.reload()\">Ngắt kết nối</button>\n  </div>\n</div>\n\n<div id=\"toast\"></div>\n\n<script>\n'use strict';\nconst SVC  = '48555449-4555-4d53-0001-000000000000';\nconst CH = {\n  state:'48555449-4555-4d53-0002-000000000000',\n  temps:'48555449-4555-4d53-0003-000000000000',\n  ai   :'48555449-4555-4d53-0004-000000000000',\n  pack :'48555449-4555-4d53-0005-000000000000',\n  sys  :'48555449-4555-4d53-0006-000000000000',\n  diag :'48555449-4555-4d53-0007-000000000000',\n  l2   :'48555449-4555-4d53-0009-000000000000',\n  cmd  :'48555449-4555-4d53-0008-000000000000',\n};\nconst D = {}, chars = {};\nlet muted = false, quiet = false, dev = null;\n\nconst $ = id => document.getElementById(id);\nconst dec = new TextDecoder(), enc = new TextEncoder();\n\nfunction toast(m, ms){ const t=$('toast'); t.textContent=m; t.style.opacity=1;\n  clearTimeout(t._h); t._h=setTimeout(()=>t.style.opacity=0, ms||2400); }\n\n/* ---------- kết nối ------------------------------------------------------ */\n$('btnConnect').onclick = async () => {\n  if (!navigator.bluetooth) {\n    $('gateWarn').innerHTML = '<b>Trình duyệt này không hỗ trợ Web Bluetooth.</b><br>'+\n      'Dùng <b>Chrome trên Android</b>. iPhone/Safari không chạy được — đó là giới hạn '+\n      'của iOS, không phải lỗi của trang.';\n    return;\n  }\n  try {\n    toast('Đang tìm pack…');\n    // Lọc theo UUID dịch vụ chứ không theo tên: tên có thể bị đổi, dịch vụ thì không.\n    dev = await navigator.bluetooth.requestDevice({filters:[{services:[SVC]}]});\n    dev.addEventListener('gattserverdisconnected', onDrop);\n    const srv = await (await dev.gatt.connect()).getPrimaryService(SVC);\n\n    for (const [k,u] of Object.entries(CH)) {\n      try { chars[k] = await srv.getCharacteristic(u); } catch(e){ chars[k]=null; }\n    }\n    // Đọc một lượt để có số ngay, rồi bật notify để tự cập nhật.\n    for (const k of ['state','temps','ai','pack','sys','diag','l2']) {\n      if (!chars[k]) continue;\n      D[k] = dec.decode(await chars[k].readValue()).trim();\n      chars[k].addEventListener('characteristicvaluechanged',\n        e => { D[k] = dec.decode(e.target.value).trim(); draw(); });\n      await chars[k].startNotifications();\n    }\n    $('gate').classList.add('hide');\n    $('app').classList.remove('hide');\n    $('link').textContent = dev.name || 'đã kết nối';\n    draw();\n    toast('Đã kết nối');\n  } catch (e) {\n    toast(/cancel|User cancelled/i.test(e.message) ? 'Đã huỷ' : ('Lỗi: '+e.message), 4000);\n  }\n};\n\n/* Mất sóng thì PHẢI nói ra. Giữ nguyên màn hình cũ mà không báo gì là để người\n   dùng tin vào số đã chết — đúng chế độ hỏng mà cả firmware lẫn dashboard đều\n   đã chống ở những chỗ khác. */\nfunction onDrop(){\n  $('banner').className = '';\n  $('banner').querySelector('.lvl').textContent = 'MẤT KẾT NỐI';\n  $('bsub').textContent = 'Số hiển thị bên dưới đã cũ. Đứng gần pack rồi bấm kết nối lại.';\n  $('link').textContent = 'mất sóng';\n  toast('Mất kết nối Bluetooth', 6000);\n}\n\n/* ---------- lệnh --------------------------------------------------------- */\nasync function cmd(which){\n  if (!chars.cmd) return toast('Thiết bị không nhận lệnh');\n  const on = which==='mute' ? !muted : !quiet;\n  try {\n    await chars.cmd.writeValue(enc.encode(`${which} ${on?'on':'off'}`));\n    toast(dec.decode(await chars.cmd.readValue()).trim(), 3500);\n  } catch(e){\n    toast(/auth|encrypt|pair|Insufficient/i.test(e.message)\n      ? 'Cần ghép đôi: nhập mã hiện trên nhãn thiết bị rồi bấm lại'\n      : ('Không gửi được: '+e.message), 5000);\n  }\n}\n\n/* ---------- vẽ ----------------------------------------------------------- */\nconst LVL = [\n  ['Bình thường','Sáu cell đang bám sát nhau','b-ok'],\n  ['Theo dõi','AI thấy một cell lệch, đang đếm giờ xác nhận','b-watch'],\n  ['BÁO ĐỘNG','Một cell lệch đủ lâu để xác nhận là bất thường','b-alarm'],\n  ['NGUY KỊCH','Có cell vượt ngưỡng cứng 60 °C','b-crit'],\n];\n// Bắt theo chuỗi mà firmware phát ra (ble_view.cpp levelText).\nfunction levelOf(s){\n  if (!s) return -1;\n  if (s.startsWith('NGUY KICH')) return 3;\n  if (s.startsWith('BAO DONG'))  return 2;\n  if (s.startsWith('THEO DOI'))  return 1;\n  if (s.startsWith('BINH THUONG'))return 0;\n  return -1;\n}\nconst PAT = {\n  'TH-1':['Nóng lên nhanh hơn cả pack (TH-1)','Ngắt sạc, ngắt tải, cách ly pack ra chỗ thoáng'],\n  'TH-2':['Nóng hơn nhưng ổn định (TH-2)','Chưa khẩn cấp. Ghi sổ, kiểm ở lần bảo dưỡng'],\n  'TH-3':['Lạnh bất thường (TH-3)','Kiểm mối nối của cell và xem cảm biến còn dán chặt'],\n};\n\nfunction draw(){\n  const st = D.state||'', lvl = levelOf(st);\n  muted = /TAT TIENG/.test(st); quiet = /bip thua/.test(st);\n\n  const b=$('banner'), L=LVL[lvl];\n  if (L){\n    b.className = L[2] + (lvl>=2?' pulse':'');\n    b.querySelector('.lvl').textContent = L[0] + (muted?'  🔇':'');\n    $('bsub').textContent = L[1] + (muted?' · còi đang bị tắt tiếng':'');\n  }\n\n  // \"1:26.5 2:26.3 ...\" -> mảng\n  const t=[]; (D.temps||'').split(/\\s+/).forEach(p=>{\n    const m=p.match(/^(\\d+):(.+)$/); if(m) t[+m[1]-1]= m[2]==='--'?null:parseFloat(m[2]);\n  });\n  const worst = (D.ai||'').match(/CELL (\\d+)/i);\n  $('cells').innerHTML = t.map((v,i)=>{\n    const hot = worst && +worst[1]===i+1 && lvl>=2;\n    return `<div class=\"cell${hot?' hot':''}\"><div class=\"n\">Cell ${i+1}</div>\n            <div class=\"t\">${v==null?'--':v.toFixed(1)}</div></div>`;\n  }).join('');\n\n  const tag = (D.ai||'').match(/TH-[123]/);\n  const dc = $('diagcard');\n  if (tag && PAT[tag[0]]) {\n    dc.classList.remove('hide');\n    const [what,todo] = PAT[tag[0]];\n    $('dwhat').textContent = (worst?`Cell ${worst[1]} — `:'') + what +\n                             (lvl<2 ? '  (chưa tới mức báo động)' : '');\n    $('ddo').textContent = '→ ' + todo;\n    $('dnums').textContent = D.diag||'';\n  } else dc.classList.add('hide');\n\n  const sp = t.filter(v=>v!=null);\n  $('pack').innerHTML =\n    kv('Chênh lệch nóng nhất − lạnh nhất',\n       sp.length ? (Math.max(...sp)-Math.min(...sp)).toFixed(2)+' °C' : '—') +\n    kv('Điện áp / dòng', D.pack||'—') +\n    kv('Hệ thống', D.sys||'—');\n\n  // Lớp 2 — tính ngay trên thiết bị, nên có số cả khi không có mạng.\n  const l2 = D.l2||'';\n  if (l2 && !/chua co chu ky/.test(l2)) {\n    $('l2card').classList.remove('hide');\n    const soh  = l2.match(/SOH ([\\d.]+)%/);\n    const cyc  = l2.match(/con ~([\\d.]+) chu ky/);\n    const log  = l2.match(/da ghi (\\d+) chu ky/);\n    const tr   = l2.match(/xu huong ([+\\-\\d.]+) %\\/chu ky/);\n    const ngoai = /NGOAI DAI/.test(l2);\n    $('l2').innerHTML =\n      kv('Sức khoẻ (SOH)', soh?soh[1]+' %':'—') +\n      kv('Còn lại (RUL)',  cyc?'~'+cyc[1]+' chu kỳ':'—') +\n      (tr ? kv('Xu hướng', tr[1]+' %/chu kỳ') : '') +\n      kv('Chu kỳ đã ghi', log?log[1]:'—');\n    // Cảnh báo ngoại suy phải NỔI BẬT hơn con số. Mô hình tuyến tính không bao\n    // giờ từ chối trả lời — nó luôn ra một số trông hợp lý.\n    $('l2warn').innerHTML = ngoai\n      ? '<b style=\"color:var(--alarm)\">⚠️ Đầu vào nằm ngoài dải mô hình đã học — '+\n        'con số trên KHÔNG đáng tin.</b>'\n      : 'Hệ số hiệu chỉnh trên bộ chuẩn NASA (cùng loại cell 18650), '+\n        'sai số ±12 chu kỳ. Tính ngay trên thiết bị nên không cần mạng.';\n  } else $('l2card').classList.add('hide');\n\n  tog('bmute', muted, 'Bật lại tiếng','Tắt tiếng');\n  tog('bquiet',quiet, 'Đang bíp thưa','Bíp thưa');\n}\nfunction kv(k,v){ return `<div class=\"kv\"><span>${k}</span><b>${v}</b></div>`; }\nfunction tog(id,on,a,b){ const e=$(id); e.classList.toggle('on',!!on); e.textContent=on?a:b; }\n</script>\n</html>\n",
        "output": "str",
        "x": 400,
        "y": 500,
        "wires": [
            [
                "app_resp"
            ]
        ]
    },
    {
        "id": "app_resp",
        "type": "http response",
        "z": "1c36b21664cab788",
        "name": "",
        "statusCode": "",
        "headers": {
            "content-type": "text/html; charset=utf-8"
        },
