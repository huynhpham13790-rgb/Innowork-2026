  {
    "id": "cmd_fn",
    "type": "function",
    "z": "tab_demo_ctl",
    "name": "loc lenh + dat topic",
    "func": "// CHI cho qua bon lenh nay. Danh sach trang chu khong phai danh sach den:\n// them lenh moi phai sua o day, nen khong the vo tinh mo mot duong dieu khien\n// nao do chi vi doi payload o trinh duyet.\nconst OK = ['heat', 'heat_stop', 'mute', 'quiet'];\nconst p = msg.payload || {};\nif (!OK.includes(p.cmd)) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'lenh khong nam trong danh sach trang' };\n    return [null, msg];\n}\n// nodeId phai khop NODE_ID trong firmware (buildTopics)\nconst NODE_ID = 'DAN_NODE_ID_VAO_DAY';\nconst out = { topic: '/wisepaas/scada/' + NODE_ID + '/cmd', payload: JSON.stringify(p) };\n// PHAI dung lai `msg` cho nhanh tra loi, khong duoc tao object moi: node\n// `http response` can msg.res de biet tra ve cho request nao. Tao object moi\n// lam mat msg.res => lenh VAN toi thiet bi nhung trinh duyet treo vinh vien.\n// Da dinh dung loi nay 21/09.\nmsg.statusCode = 200;\nmsg.payload = { ok: true };\nreturn [out, msg];",
