[
  {
    "id": "tab_demo_ctl",
    "type": "tab",
    "label": "Bang dieu khien demo",
    "disabled": false,
    "info": "Nut bam de xin bat suoi khi diễn, va tat tieng coi.\n\nCLOUD CHI DUOC XIN, THIET BI MOI QUYET. Flow nay chi gui lenh; moi han muc an toan nam tren ESP32 va khong lenh nao tu day nang duoc.\n\nLenh xin tu het han sau 15s. Trang web tu gia han moi 5s khi cong tac dang BAT. Dong tab = het gia han = suoi TAT.\n\nMo: http://127.0.0.1:1880/hutieu"
  },
  {
    "id": "ui_page",
    "type": "http in",
